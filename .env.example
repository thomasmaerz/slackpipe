# Example workspace credential file. Repeat this block for every workspace.
# Keep the real .env mode 0600 and never commit it.
# WORKSPACE is the single identity: the real Slack workspace name, verbatim.
# It becomes the archive directory name, the Slackdump -workspace label, the
# Dagster workspace_id, and the DuckDB workspace_slug. Comment lines are
# documentation only and are never parsed.
# Example Workspace - https://example-workspace.slack.com
WORKSPACE=Example Workspace
CHANNEL_URL=https://example-workspace.slack.com
SLACK_TOKEN=<replace-with-slack-token>
SLACK_COOKIE=<replace-with-slack-cookie>

# Attachment bytes remain disabled during initial development.
SLACKPIPE_ATTACHMENTS_INCREMENTAL=false
SLACKPIPE_ENABLE_DEFERRED_BACKFILLS=false
