DAGSTER_POSTGRES_USER=slackpipe
DAGSTER_POSTGRES_PASSWORD=<replace-with-strong-database-password>
DAGSTER_POSTGRES_DB=dagster
DAGSTER_WEB_PORT=3000
DAGSTER_BIND_ADDRESS=127.0.0.1
SLACKPIPE_IMAGE=slackpipe:local
SLACKDUMP_VERSION=4.4.5
SLACKPIPE_PUSHGATEWAY_PORT=9092
SLACKPIPE_BIND_ADDRESS=127.0.0.1
SLACKPIPE_ALLOW_LINEAGE_BOOTSTRAP=false
SLACKPIPE_ENABLE_DEFERRED_BACKFILLS=false
# Comma-separated workspace IDs or slugs with their own manual workflow:
# left out of the all-workspaces rollout jobs, schedules default to stopped.
# Empty means all discovered workspaces roll out together.
# Example: SLACKPIPE_SOLO_WORKSPACES=leadership
SLACKPIPE_SOLO_WORKSPACES=
# ISO 8601 staleness window for steady-state incremental resumes
# (Slackdump -skip-stale-threads/-skip-stale-channels, e.g. p90d).
# Empty disables stale skipping (full sweep). Initial ingestions
# ({slug}_ingest_once) never skip regardless of this value.
SLACKPIPE_INCREMENTAL_STALE_AFTER=p90d
# Extra file_id=bytes entries extending the built-in documented attachment
# size variance record (comma-separated, e.g. "F0123456789=70095357").
# A mismatch matching an entry passes as documented variance; anything
# else still fails. Empty means only the built-in record applies.
SLACKPIPE_ATTACHMENT_SIZE_ACCEPT=
SLACKPIPE_WORKSPACE_DIR_PATH=/etc/slackpipe
SLACKPIPE_DEPLOYMENT_PATH=./deployment
SLACKPIPE_SOURCE_PATH=./src
SLACKPIPE_PROJECT_FILE_PATH=./pyproject.toml
SLACKPIPE_SLACKDUMP_PATH=./slackdump
SLACKPIPE_DATA_PATH=./data
# Slackquery remains a separate Git-owned codebase. Compose uses the local image
# when present and this source tree as its explicit build context.
SLACKQUERY_IMAGE=slackquery:local
SLACKQUERY_BUILD_CONTEXT=../slackquery
SLACKQUERY_ENV_FILE=../slackquery/.env
SLACKQUERY_STATE_PATH=../slackquery/state
SLACKQUERY_ARTIFACT_PATH=../slackquery/artifacts
SLACKQUERY_EXTENSION_PATH=../slackquery/extensions
SLACKQUERY_BUILD_CONTEXT=/root/slackquery
SLACKQUERY_ENV_FILE=/opt/slackquery/slackquery.env
SLACKQUERY_STATE_PATH=/opt/slackquery/state
SLACKQUERY_ARTIFACT_PATH=/opt/slackquery/artifacts
SLACKQUERY_EXTENSION_PATH=/opt/slackquery/extensions
